{
  "manifest_version": 3,
  "name": "STARLIMS LocalFS Test",
  "version": "1.0.0",
  "permissions": ["nativeMessaging"],
  "host_permissions": ["http://127.0.0.1:5500/*"],
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1:5500/*"],
      "js": ["content.js"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}